# Bind address for the dashboard/API. Defaults to localhost-only for safety
# (see spec's access-control section). Set to your LAN interface IP, or to
# 0.0.0.0, only if you deliberately want the dashboard reachable from other
# devices on your network.
PORT=3100
HOST=127.0.0.1
SINK_DB_PATH=../unifi-siem-sink/data/events.db
LENS_DB_PATH=./data/lens.db
LAN_CIDRS=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12
LOG_LEVEL=info

# Optional — enables enrichment (client/device name lookup, firewall summary) via a sibling
# unifi-mcp-server instance. Leave unset to skip enrichment entirely (default, safe).
# UNIFI_MCP_SERVER_URL=http://localhost:3000/mcp
