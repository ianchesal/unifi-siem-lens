# Bind address for the dashboard/API. Defaults to localhost-only for safety
# (see spec's access-control section). Set to your LAN interface IP, or to
# 0.0.0.0, only if you deliberately want the dashboard reachable from other
# devices on your network.
PORT=3002
HOST=127.0.0.1
SINK_DB_PATH=../unifi-siem-sink/data/events.db
LENS_DB_PATH=./data/lens.db
LAN_CIDRS=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12
LOG_LEVEL=info

# Comma-separated admin display names (as they appear in UniFi's audit log)
# that auto-dismiss console-login findings for those admins. Empty = rule never fires.
TRUSTED_ADMIN_NAMES=

# Comma-separated IDS/IPS signature-family prefixes that auto-dismiss a finding
# when every backing event is a blocked hit from one of these families.
# Defaults to ET DROP,ET CINS,ET TOR,ET COMPROMISED,ET DSHIELD if unset.
# SAFE_SIGNATURE_PREFIXES=

# Required. Bearer token clients must send as `Authorization: Bearer <MCP_SECRET>`
# to call the /mcp endpoint. Choose a strong random value.
MCP_SECRET=

# Optional — enables enrichment (client/device name lookup, firewall summary) via a sibling
# unifi-mcp-server instance. Leave unset to skip enrichment entirely (default, safe).
# UNIFI_MCP_SERVER_URL=http://localhost:3000/mcp
